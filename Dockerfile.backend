# ScoreFlow Backend - Python 3.12 + ML dependencies
# Python 3.12 required: TensorFlow/PyTorch not compatible with 3.13+
FROM python:3.12-slim

# System dependencies (no-recommends: avoids pulling X11/SDL/GUI baggage)
# ffmpeg alone would pull ~200 deps with recommends → OOM on Docker Desktop
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Stage 1: pip install (uses network, slow in China) ──
# crepe (0.0.16) has legacy setup.py using pkg_resources → setuptools<70 fixes it.
# basic-pitch 0.4.0 pins tensorflow<2.15.1 but PyPI only has >=2.16 for py312.
#   Workaround: install basic-pitch --no-deps; ONNX runtime replaces TF for inference.
RUN pip install --no-cache-dir 'setuptools<70' wheel

# Core deps (no conflict, fast to install)
RUN pip install --no-cache-dir --no-build-isolation \
    fastapi>=0.104.0 \
    'uvicorn[standard]>=0.24.0' \
    python-multipart>=0.0.6 \
    pydantic>=2.0 \
    librosa>=0.10.0 \
    numpy>=1.24.0 \
    soundfile>=0.12.0 \
    onnxruntime>=1.15.0

# crepe: its setup.py downloads ~84MB of model weights → retry on network flakes
RUN for i in 1 2 3; do \
        pip install --no-cache-dir --no-build-isolation crepe>=0.0.16 && break || sleep 10; \
    done

# demucs + torch (large download, ~2GB)
RUN pip install --no-cache-dir --no-build-isolation \
    demucs>=4.0.0 \
    torch>=2.0.0

# basic-pitch: install WITHOUT its hard TF dependency (ONNX runtime handles inference)
RUN pip install --no-cache-dir --no-deps basic-pitch==0.4.0 && \
    pip install --no-cache-dir --no-build-isolation \
    'mir-eval>=0.6' \
    'pretty-midi>=0.2.9' \
    'resampy>=0.2.2,<0.4.3'

# Verovio: professional music notation engraving (MusicXML → SVG)
RUN pip install --no-cache-dir verovio>=4.3.0

# ── Stage 2: preload ML models into the image ──
COPY preload_models.py /app/preload_models.py
RUN python /app/preload_models.py

# ── Stage 3: application code ──
COPY backend/ /app/backend/
COPY engine/ /app/engine/

# Create runtime directories
RUN mkdir -p /app/backend/uploads /app/backend/output

WORKDIR /app/backend

# Model cache directory (volume mount overrides at runtime)
ENV BASIC_PITCH_CACHE_DIR=/app/backend/.model_cache
ENV TORCH_HOME=/app/backend/.model_cache/torch
ENV TFHUB_CACHE_DIR=/app/backend/.model_cache/tfhub

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
